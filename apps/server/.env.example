# Local-only defaults for docker compose Postgres. These are NOT secrets —
# they only work against the container defined in compose.yaml on localhost.
# Real deployments must override every value below with securely generated,
# environment-specific ones.
DATABASE_URL=postgres://kpi:kpi@localhost:5435/kpi_schedule?sslmode=disable

# Shared secret required in the X-Internal-Token header for all /api/v1 routes except /healthz.
# "dev" is fine locally; deployments must set a real generated secret.
INTERNAL_API_TOKEN=dev

# HTTP listen address
HTTP_ADDR=:8080

# No SESSION_ENCRYPTION_KEY: the server never stores my.kpi.ua credentials.
# The browser extension authenticates using the student's own browser
# session and pushes only the already-extracted schedule — see
# docs/architecture/data-storage.md §1. There is nothing to encrypt at rest.

# External API keys (if any are ever added) are NOT covered by the "local
# convenience values" rule above — they must stay out of this file and be
# treated as real secrets even in the local (gitignored) .env.
