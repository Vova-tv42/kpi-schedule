# Path to the SQLite database file.
# - Local dev: ./data/kpi.db (parent directory created automatically).
# - Production (Fly.io): /data/kpi.db (inside the mounted Fly Volume at /data).
DATABASE_PATH=./data/kpi.db

# Shared secret required in the X-Internal-Token header for all /api/v1 routes except /healthz.
# - Local dev: dev (convenience value for manual testing).
# - Production (Fly.io): Real secret generated via `openssl rand -hex 32` (set via `fly secrets set`).
INTERNAL_API_TOKEN=dev

# HTTP listen address
HTTP_ADDR=:8080

# Inactivity shutdown timeout for scale-to-zero (e.g. Fly.io).
# - Local dev: 0s (copy-pasteable default; disables idle shutdown so the server stays awake while developing).
# - Production (Fly.io): 15m (sleeps after 15 minutes of inactivity to minimize hosting costs).
IDLE_TIMEOUT=0s

# Telegram bot configuration (see docs/api/local-development.md §7).
# Optional: if TELEGRAM_BOT_TOKEN is unset, the bot is not started and the server runs API-only.
# - Local dev & Production: Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Required when TELEGRAM_BOT_TOKEN is set:
# - Local dev: Public HTTPS tunnel URL (e.g. ngrok: https://<subdomain>.ngrok-free.app/api/v1/telegram/webhook)
# - Production: https://<your-app-name>.fly.dev/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=https://<your-hostname>/api/v1/telegram/webhook
# Secret token to validate incoming webhook requests via X-Telegram-Bot-Api-Secret-Token.
# Allowed characters: A-Z, a-z, 0-9, _, - (1-256 chars). Generate via: `openssl rand -hex 32`
# - Local dev: Pre-filled with convenience secret below.
# - Production: Generate a distinct secret via `openssl rand -hex 32` and set via `fly secrets set`.
TELEGRAM_WEBHOOK_SECRET=63a1e23a1e576bc605cf83fc80f013df7560e85348c91e33f9df0c1132e9baee
 
# Optional: external URL for the extension install/download button in the bot (e.g. Google Drive, Chrome Web Store, GitHub Release).
# If unset, no direct external download button is shown on the /install screen.
# EXTENSION_INSTALL_URL=https://drive.google.com/drive/folders/your-folder-id

# ==============================================================================
# Admin Dashboard Integration (apps/admin)
# ==============================================================================
# Shared secret required in the X-Admin-Secret header for all /api/v1/admin/* routes.
# - If unset, falls back to INTERNAL_API_TOKEN.
# - Production (Fly.io): Set via `fly secrets set ADMIN_API_SECRET="..."` (matches MAIN_SERVER_ADMIN_SECRET in admin dashboard).
ADMIN_API_SECRET=dev

# Ingestion endpoint on the Admin Dashboard for anonymous action telemetry.
# - Local dev: http://localhost:5173/api/ingest/action
# - Production: https://<your-admin-app>.vercel.app/api/ingest/action
# If unset, anonymous telemetry reporting is disabled.
ADMIN_INGEST_URL=

# Shared secret key passed in the X-Ingest-Key header to authenticate telemetry payloads.
# Must match ADMIN_INGEST_KEY in apps/admin.
ADMIN_INGEST_KEY=

# No SESSION_ENCRYPTION_KEY: the server never stores my.kpi.ua credentials.
# The browser extension authenticates using the student's own browser
# session and pushes only the already-extracted schedule — see
# docs/architecture/data-storage.md §1. There is nothing to encrypt at rest.

# External API keys (if any are ever added) are NOT covered by the "local
# convenience values" rule above — they must stay out of this file and be
# treated as real secrets even in the local (gitignored) .env.
