# KPI Schedule Admin Dashboard Environment Configuration

# 1. Database Connection
# Local Docker Postgres (run `bun run db:up` to start container on port 5435):
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/kpi_admin"
# Production (NeonDB Serverless PostgreSQL on Vercel):
# DATABASE_URL="postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/kpi_admin?sslmode=require"

# 2. Google OAuth 2.0 Credentials (https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# 3. Superadmin Whitelist Email (Single owner email address from secret variables)
SUPERADMIN_EMAIL="admin@kpi.ua"

# 4. Ingestion & Cron Secrets
# Key shared with Go main server to authenticate anonymous action telemetry ingest
ADMIN_INGEST_KEY="generate-secure-random-32-char-key"
# Secret used by cron-jobs.com or Vercel Cron to authorize cleanup runs
CRON_SECRET="generate-secure-random-32-char-key"

# 5. Fly.io Machines API Integration (Non-waking scale-to-zero status inspection)
FLY_API_TOKEN="FlyV1 fm2_readonly_token_here"
FLY_APP_NAME="kpi-schedule"

# 6. Main Go Server Connection (Access to SQLite volume for tables & queries)
MAIN_SERVER_URL="https://kpi-schedule.fly.dev"
# Must match the Go main server's ADMIN_API_SECRET (or INTERNAL_API_TOKEN)
MAIN_SERVER_ADMIN_SECRET="matches-internal-api-token-or-admin-secret"
